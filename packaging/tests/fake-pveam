#!/usr/bin/env bash
# Test double for pveam, the companion to fake-pct. Only the `list` path
# matters: install.sh's resolve_template takes the template from it and skips
# the update/available/download branch entirely, so a non-dry PVE run needs no
# catalog and no network.
set -euo pipefail
case "${1:-}" in
  # Real pveam exits non-zero on a pool with no vztmpl content ("storage
  # 'local-lvm' does not support template directory"). Refusing it here is the
  # whole point of this double: passing the rootdir pool used to kill the
  # installer in silence, so the fake must not accept any pool handed to it.
  list)
    case "${2:-}" in
      local) printf '%s\n' "local:vztmpl/debian-12-standard_12.7-1_amd64.tar.zst 0 0" ;;
      *) echo "storage '${2:-}' does not support template directory" >&2; exit 255 ;;
    esac
    ;;
  *)    : ;;
esac
exit 0
