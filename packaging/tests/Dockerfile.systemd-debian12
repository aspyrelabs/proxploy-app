# The stock `debian:12` image has no /sbin/init: it is a minimal userland,
# not a bootable systemd system, so plans that assume `docker run debian:12
# /sbin/init` works are wrong. This adds just systemd on top so the install
# harnesses (Tasks 12, 13) get a real systemd as PID 1, matching a Proxmox
# LXC closely enough to run install.sh for real.
FROM debian:12
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends systemd systemd-sysv dbus \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
