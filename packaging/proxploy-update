#!/usr/bin/env bash
# Proxploy self-update (Phase 9a).
#
# Runs OUTSIDE the app's cgroup, launched by systemd-run from
# services/updater.py::launch. That is deliberate: this script restarts
# proxploy.service, and anything inside that cgroup would be killed halfway
# through, leaving the symlink swapped and nothing serving.
#
# Order matters and is not negotiable:
#   backup BEFORE download   (a full disk must not cost you the database)
#   verify BEFORE unpack     (never write unverified bytes into releases/)
#   migrate BEFORE switch    (a failed migration leaves the old version running)
#   health  AFTER  switch    (and any failure from here rolls back)
set -euo pipefail

# Installed layout is $PP_BIN/proxploy-update sourcing $PP_LIB/common.sh
# (both under /opt/proxploy: see install.sh step 7), so the relative and
# fallback paths below resolve to the same file in production. The relative
# path also lets this script run straight out of a release/build checkout
# before it has been installed anywhere.
# shellcheck source=lib/common.sh
. "$(dirname "$0")/../lib/common.sh" 2>/dev/null || . /opt/proxploy/lib/common.sh

TO=""; CHANNEL=""; FORCE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --to) TO="$2"; shift 2 ;;
    --channel) CHANNEL="$2"; shift 2 ;;
    --force) FORCE=1; shift ;;
    *) die "unknown argument: $1" ;;
  esac
done
[ -n "$TO" ] || die "--to <version> is required"
[ -n "$CHANNEL" ] || die "--channel <url> is required"
need_root

FROM=$(basename "$(readlink -f "$PP_CURRENT")")
BACKUP="$PP_DATA/pre-update/$FROM"

rollback() {
  log "rolling back to $FROM"
  # Stop first, and restore into a stopped service. $TO has been crash-looping
  # on RestartSec=3 for up to the 120s deadline below, so restoring under a
  # live unit races a process that is starting up on the same database. That
  # loop also trips systemd's default start-limit (5 starts / 10s), which
  # leaves the unit in a failed state a bare `start` will not clear, 
  # reset-failed is a no-op otherwise, so it is safe unconditionally.
  systemctl stop proxploy.service 2>/dev/null || true
  systemctl reset-failed proxploy.service 2>/dev/null || true
  ln -sfn "$PP_RELEASES/$FROM" "$PP_CURRENT.tmp" && mv -T "$PP_CURRENT.tmp" "$PP_CURRENT"
  if [ -f "$BACKUP/proxploy.db" ]; then
    # -wal/-shm belong to the database being replaced, not to the backup;
    # leaving them for sqlite to replay over a different file is corruption.
    rm -f "$PP_DATA/proxploy.db-wal" "$PP_DATA/proxploy.db-shm"
    # Plain cp then chown, NOT `cp -a`: the backup was written by `sqlite3
    # .backup` running as root, so preserving its ownership hands the live
    # database back as root:root while the unit runs as User=proxploy. The
    # app then crash-loops on "attempt to write a readonly database": a
    # rollback that restores the data perfectly and still leaves the box down.
    cp "$BACKUP/proxploy.db" "$PP_DATA/proxploy.db"
    chown "$PP_USER:$PP_USER" "$PP_DATA/proxploy.db"
  fi
  systemctl start proxploy.service || true
  # Type=exec reports "active" the moment the process execs, not once uvicorn
  # has opened the port. Wait for the same health signal the forward path
  # waits for, on a shorter deadline since $FROM was healthy moments ago; 
  # otherwise a caller checking health right after we exit sees a false "down".
  local rb_deadline
  rb_deadline=$(($(date +%s) + 60))
  until curl -fsS --max-time 5 http://127.0.0.1:8000/api/v1/meta/health >/dev/null 2>&1; do
    [ "$(date +%s)" -lt "$rb_deadline" ] || break
    sleep 2
  done
  die "update to $TO failed; rolled back to $FROM"
}

# --- preflight -------------------------------------------------------------
[ "$TO" != "$FROM" ] || die "already running $TO"
if [ -d "$PP_RELEASES/$TO" ] && [ "$FORCE" -eq 0 ]; then
  die "$TO is already unpacked; use --force"
fi
avail=$(df -Pk "$PP_ROOT" | awk 'NR==2 {print $4}')
[ "$avail" -gt 2097152 ] || die "less than 2 GiB free on $PP_ROOT, refusing to update"

# --- backup ----------------------------------------------------------------
log "backing up $FROM"
mkdir -p "$BACKUP"
if [ -f "$PP_DATA/proxploy.db" ]; then
  # sqlite3 .backup is safe against a live writer; cp is not.
  sqlite3 "$PP_DATA/proxploy.db" ".backup '$BACKUP/proxploy.db'"
fi
cp -a "$PP_DATA/master.key" "$BACKUP/master.key" 2>/dev/null || true
echo "$FROM" > "$BACKUP/version"

# --- download + verify -------------------------------------------------------
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
log "fetching $TO"
fetch_to "$CHANNEL/manifest.json"     "$work/manifest.json"
fetch_to "$CHANNEL/manifest.json.sig" "$work/manifest.json.sig"
tarball=$(manifest_field name "$work/manifest.json")
[ -n "$tarball" ] || die "manifest.json has no artifact name"
fetch_to "$CHANNEL/$tarball" "$work/$tarball"
verify_release "$work" "$PP_CURRENT/backend/proxploy/release_pubkey.pem"

# --- unpack + migrate --------------------------------------------------------
log "installing $TO"
install_release "$work/$tarball" "$TO"
log "migrating database"
# config.py's Settings has no env_file: it only reads PROXPLOY_* from the
# process environment, which systemd-run (services/updater.py::launch) does
# not hand this script. Source the installer's env file by hand, the same
# way install.sh does, or alembic's env.py falls back to the default
# relative sqlite path and fails with "unable to open database file".
set -a
# shellcheck source=/dev/null
. "$PP_ENV"
set +a

# --- environment migration ---------------------------------------------------
# Every install made before this release carries PROXPLOY_ENV=dev, because the
# published installer defaulted to dev while api.proxploy.com was not yet
# answering and that default was never flipped. Those boxes licence against
# api.proxploy.dev and fetch their own updates from web.proxploy.dev, so the
# dev channel is the ONLY way this fix can reach them: it must keep serving
# until they have all taken this release.
#
# Rewritten here rather than in install.sh, which leaves an existing env file
# alone on purpose so a re-run cannot clobber an operator's settings.
#
# An operator who deliberately wants dev sets PROXPLOY_ENV_PINNED=1 in the
# same file, which is checked first and is never overwritten. Without a record
# of which URL a box was installed from there is no way to tell a deliberate
# dev install from one that simply inherited the broken default, so the
# migration runs and the pin is the documented way to opt back in.
if grep -qE '^PROXPLOY_ENV_PINNED=1' "$PP_ENV" 2>/dev/null; then
  log "PROXPLOY_ENV is pinned, leaving it at ${PROXPLOY_ENV:-unset}"
elif grep -qE '^PROXPLOY_ENV=dev[[:space:]]*$' "$PP_ENV" 2>/dev/null; then
  log "migrating PROXPLOY_ENV from dev to prod"
  cp -a "$PP_ENV" "$PP_ENV.bak-$(date +%Y%m%d%H%M%S)"
  tmp_env=$(mktemp)
  sed 's/^PROXPLOY_ENV=dev[[:space:]]*$/PROXPLOY_ENV=prod/' "$PP_ENV" > "$tmp_env"
  if grep -qE '^PROXPLOY_ENV=prod$' "$tmp_env"; then
    cat "$tmp_env" > "$PP_ENV"
    rm -f "$tmp_env"
    set -a; . "$PP_ENV"; set +a
    log "PROXPLOY_ENV is now prod; updates will come from proxploy.com"
  else
    rm -f "$tmp_env"
    log "could not rewrite PROXPLOY_ENV, leaving it at dev"
  fi
fi
if ! migrate_release "$PP_RELEASES/$TO"; then
  # Nothing was switched: the old version is still running and its database
  # was never touched by a migration that failed to apply. Rolling back here
  # would restore a backup over a database that is already unchanged: that
  # would be the bug, not the fix.
  log "migration failed; nothing was switched"
  exit 1
fi

# --- switch + health ----------------------------------------------------------
log "switching to $TO"
ln -sfn "$PP_RELEASES/$TO" "$PP_CURRENT.tmp" && mv -T "$PP_CURRENT.tmp" "$PP_CURRENT"
systemctl restart proxploy.service || rollback

deadline=$(($(date +%s) + 120))
until curl -fsS --max-time 5 http://127.0.0.1:8000/api/v1/meta/health >/dev/null 2>&1; do
  [ "$(date +%s)" -lt "$deadline" ] || rollback
  sleep 2
done

log "update to $TO complete"
