[Unit]
Description=Proxploy
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
# current/ is a symlink; the swap in proxploy-update is what makes rollback
# a pointer move rather than a reinstall.
WorkingDirectory=/opt/proxploy/current/backend
EnvironmentFile=/etc/proxploy/proxploy.env
# --proxy-headers trusts X-Forwarded-For/-Proto only from peers listed in
# FORWARDED_ALLOW_IPS, which uvicorn defaults to 127.0.0.1 (config.py) if
# unset, i.e. exactly where install.sh puts Caddy. Pinned here explicitly so
# a future uvicorn default change cannot silently turn every audit row back
# into 127.0.0.1. An operator whose proxy runs elsewhere sets
# FORWARDED_ALLOW_IPS in /etc/proxploy/proxploy.env. The matching CLI flag
# for that allow list is deliberately NOT set here: a CLI value would beat
# the env var and kill the override.
#
# --ws-per-message-deflate false is for the consoles. uvicorn defaults it to
# True, so every browser (they all offer permessage-deflate) gets a VNC
# stream re-compressed frame by frame in the event loop thread that also
# relays it. Measured on a 64 KiB payload against a throwaway uvicorn echo:
# 2.20 ms per round trip with deflate on versus 0.17 ms with it off, and on
# the real console path a full 1280x800 repaint took 257 ms of transfer with
# it on versus 93 to 126 ms with it off. The bytes it saves are near zero:
# noVNC asks for Tight, so the payload is already JPEG/zlib compressed.
ExecStart=/opt/proxploy/current/backend/venv/bin/uvicorn --factory proxploy.main:create_app --host 127.0.0.1 --port 8000 --proxy-headers --ws-per-message-deflate false
Restart=on-failure
RestartSec=3
User=proxploy
Group=proxploy
# Data and secrets live outside the release tree; an update never writes here.
StateDirectory=proxploy
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
