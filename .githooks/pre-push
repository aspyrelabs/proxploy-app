#!/bin/sh
set -e
root=$(git rev-parse --show-toplevel)
sibling="$root/../proxploy-api/proxploy_api/tiers.yaml"
if [ ! -f "$sibling" ]; then
  echo "pre-push blocked: proxploy-api is not checked out beside this repo." >&2
  echo "  expected: $sibling" >&2
  echo "  entitlement key-set parity cannot be checked without it, and CI does not check it either." >&2
  echo "  clone the sibling, or push with --no-verify if you accept the gap." >&2
  exit 1
fi
cd "$root/backend"
if [ ! -x .venv/bin/python ]; then
  echo "pre-push blocked: no venv at $root/backend/.venv" >&2
  exit 1
fi
exec .venv/bin/python -m pytest tests/ -q -m parity
